font-family = "JetBrains Mono"
font-size = 14
theme = dark:Dark+,light:catppuccin-latte
background = 0c090a

copy-on-select = clipboard

mouse-hide-while-typing = true
cursor-style = bar

window-decoration = false
focus-follows-mouse = false

keybind = ctrl+shift+h=new_split:left
keybind = ctrl+shift+j=new_split:down
keybind = ctrl+shift+l=new_split:right
keybind = ctrl+shift+k=new_split:up

keybind = ctrl+h=goto_split:left
keybind = ctrl+j=goto_split:bottom
keybind = ctrl+l=goto_split:right
keybind = ctrl+k=goto_split:top

keybind = alt+h=resize_split:left,10
keybind = alt+j=resize_split:down,10
keybind = alt+l=resize_split:right,10
keybind = alt+k=resize_split:up,10

keybind = ctrl+n=new_window
keybind = ctrl+shift+t=new_tab
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab

keybind = ctrl+d=close_window
keybind = ctrl+shift+d=close_tab

keybind = ctrl+f=toggle_maximize
keybind = ctrl+shift+f=toggle_fullscreen


shell-integration = fish
command = /usr/bin/fish --login --interactive
