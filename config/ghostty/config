font-family = "JetBrains Mono"
font-size = 14
theme = light:catppuccin-latte,dark:Dark+
background = 0c090a

copy-on-select = clipboard

mouse-hide-while-typing = true
cursor-style = bar

window-decoration = false
focus-follows-mouse = false

keybind = shift+alt+h=new_split:left
keybind = shift+alt+j=new_split:down
keybind = shift+alt+l=new_split:right
keybind = shift+alt+k=new_split:up

keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:bottom
keybind = alt+l=goto_split:right
keybind = alt+k=goto_split:top

keybind = ctrl+alt+h=resize_split:left,10
keybind = ctrl+alt+j=resize_split:down,10
keybind = ctrl+alt+l=resize_split:right,10
keybind = ctrl+alt+k=resize_split:up,10

keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+t=new_tab
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab

keybind = ctrl+shift+d=close_window
keybind = ctrl+alt+d=close_tab

keybind = ctrl+shift+f=toggle_maximize
keybind = ctrl+alt+f=toggle_fullscreen


shell-integration = fish
command = /usr/bin/fish --login --interactive
