;; Variables for system info
(defpoll time :interval "1s" "date '+%H:%M'")
(defpoll date :interval "1m" "date '+%A, %B %d, %Y'")
(defpoll battery :interval "10s" "cat /sys/class/power_supply/BAT*/capacity")
(defpoll battery_status :interval "10s" "cat /sys/class/power_supply/BAT*/status")
(defpoll volume :interval "0.2s" "wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print int($2*100)}'")
(defpoll volume_muted :interval "0.2s" "wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED && echo 'true' || echo 'false'")
(defpoll network :interval "5s" "nmcli -t -f active,ssid dev wifi | grep '^yes' | cut -d':' -f2")
(defpoll network_strength :interval "5s" "nmcli -f IN-USE,SIGNAL dev wifi | grep '*' | awk '{print $2}'")
(defpoll workspaces :interval "0.01s"
  "~/.config/eww/scripts/get_ws.sh"
)
(defpoll FW :interval "0.001s" '~/.config/eww/scripts/fw.sh')
(defpoll brightness :interval "0.2s" "brightnessctl get | awk '{print int($1)}'")
(defpoll max_brightness :interval "10s" "brightnessctl max")


;; main bar widget
(defwidget bar []
  (centerbox :orientation "h"
    (box :class "left-modules" :space-evenly false :halign "start"
      (workspaces_widget)
      (window_active))
    
    (box :class "center-modules" :space-evenly false :halign "center"
      (clock-widget))
    
    (box :class "right-modules" :space-evenly false :halign "end"
      (cliphist-widget)
      (battery-widget)
      (network-widget)
      (power-widget)
      (notification-widget))))

;; individual widgets
(defwidget workspaces_widget []
  (box
    :class "workspaces"
    :orientation "horizontal"
    :spacing 0
    (for workspace in workspaces
      (button
        :class {workspace.active ? "ws-active" : "ws"}
        :onclick "niri msg action focus-workspace ${workspace.name}"
        :hexpand true
        "${workspace.name}"
      )
    )
  )
)
(defwidget window_active []
    (box :orientation "h"
         :space-evenly "false"
         :spacing 0
         :homogeneous true
         (label :class "fw" :text FW)))

(defwidget system-tray []
  (box :class "system-tray"
    ;; add your system tray icons here
    ))

(defwidget cliphist-widget []
  (button :class "clipboard"
          :onclick "sleep 0.1 && pkill fuzzel || bash cliphist.sh"
    (label :class "clipboard-icon" :text "")))

(defwidget clock-widget []
  (button :class "clock"
          :onclick "bash calendar.sh"
          :tooltip "${date}"
    " ${time}"))
(defwidget network-widget []
  (button :class "network ${network == '' ? 'disconnected' : 'connected'}"
          :onclick "nm-connection-editor"
          :tooltip "connected to: ${network}"
    (box :space-evenly false
      (label :class "network-icon" :text " ")
      (label :class "network-name" :text "${network == '' ? 'disconnected' : network}")
      )))

(defwidget battery-widget []
  (button :class "battery ${battery < 20 ? 'low' : battery < 50 ? 'medium' : 'high'}"
          :onclick "gnome-power-statistics"
          :tooltip "battery: ${battery}% (${battery_status})"
    (box :space-evenly false
      (label :class "battery-icon" 
             :text "${battery_status == 'charging' ? '' : 
                     battery < 20 ? '󰁻' : 
                     battery < 40 ? '󰁽' : 
                     battery < 60 ? '󰁿' : 
                     battery < 80 ? '󰂁' : '󰁹'}")
      (label :class "battery-level" :text "${battery}%"))))

(defwidget notification-widget []
  (button :class "notifications"
          :onclick "makoctl dismiss"
          :onrightclick "makoctl dismiss --all"
          :tooltip "toggle notifications"
    (label :class "notification-icon" :text "")))

(defwidget power-widget []
  (button :class "power"
          :onclick "bash menu.sh"
          :tooltip "power menu"
    (label :class "power-icon" :text "")))

;; calendar popup
(defwidget calendar-popup []
  (box :class "calendar-popup"
    (calendar :class "calendar")))

;; main bar window
(defwindow bar
  :monitor 0
  :windowtype "dock"
  :geometry (geometry :x "0%"
                      :y "0%"
                      :width "100%"
                      :height "30px"
                      :anchor "top center")
  :stacking "fg"
  :exclusive true
  (bar))

;; calendar popup window
(defwindow calendar-popup
  :monitor 0
  :geometry (geometry :x "50%"
                      :y "12px"
                      :width "375px"
                      :height "250px"
                      :anchor "top center")
  :stacking "overlay"
  :windowtype "dock"
  (calendar-popup))


;; eww system info popup widget configuration

;; polls for system information
(defpoll ram_percent 
  :interval "2s" 
  :initial "0"
  `free | grep Mem | awk '{printf "%.0f", ($3/$2) * 100}'`)

(defpoll cpu_usage 
  :interval "1s" 
  :initial "0"
  `grep 'cpu ' /proc/stat | awk '{usage=($2+$4)*100/($2+$4+$5)} END {printf "%.0f", usage}'`)

(defpoll cpu_temp 
  :interval "3s" 
  :initial "0"
  `cat /sys/class/thermal/thermal_zone0/temp | awk '{printf "%.0f", $1/1000}' || echo "0"`)

(defpoll disk_usage 
  :interval "30s" 
  :initial "0"
  `df -h / | awk 'NR==2 {printf "%.0f", $5}' | sed 's/%//g'`)

(defpoll current_power_profile 
  :interval "1s" 
  :initial "balanced"
  `powerprofilesctl get 2>/dev/null || echo "balanced"`)
;; window definition
(defwindow menu_popup
  :monitor 0
  :geometry (geometry 
    :x "5px" 
    :y "12px" 
    :width "320px" 
    :height "90px"
    :anchor "top right")
  :stacking "overlay"
  :windowtype "dock"
  :wm-ignore true
  
  (box 
    :orientation "vertical" 
    :class "popup-container"
    :spacing 10
    :space-evenly false
    ;; audio-slider
    (box :orientation "v" :class "volume-container" ;; wrapper box for volume and mic volume scales
      (volume_scale) ;; volume scale
    )
    (box :orientation "v" :class "brightness-container" ;; wrapper box for volume and mic volume scales
      (brightness_scale) ;; volume scale
    )
    ;; powermenu
    (box 
      :orientation "horizontal" 
      :class "powermenu-container"
      :spacing 15
      :space-evenly true
      :halign "center"
      (button :class "metric-button"
              :onclick "loginctl poweroff"
              :tooltip "Shutdown"
        (label :text "⏻"))
      (button :class "metric-button"
              :onclick "swaylock -c 000000"
              :tooltip "Lock"
        (label :text ""))
      (button :class "metric-button"
              :onclick "loginctl suspend"
              :tooltip "Suspend"
        (label :text "󰤄"))
      (button :class "metric-button"
              :onclick "niri msg action quit"
              :tooltip "Log out"
        (label :text "󰍃"))
      (button :class "metric-button"
              :onclick "loginctl reboot"
              :tooltip "Reboot"
        (label :text "⏼"))
    )
    
    ;; system info
    (box 
      :orientation "horizontal" 
      :class "metrics-container"
      :spacing 15
      :space-evenly true
      :halign "center"
      
      (button 
        :class "metric-button"
        :onclick "notify-send 'memory usage' '󰍛 ${ram_percent}%'"
        :tooltip "memory: 󰍛 ${ram_percent}%"
        (overlay
          (circular-progress 
            :class "progress-ram"
            :value ram_percent
            :thickness 4
            :start-at 75
            :clockwise true)
          (label 
            :class "metric-icon"
            :text "󰍛")))
      (button 
        :class "metric-button"
        :onclick "notify-send 'cpu usage' '󰻠 ${cpu_usage}%'"
        :tooltip "cpu: ${cpu_usage}%"
        (overlay
          (circular-progress 
            :class "progress-cpu"
            :value cpu_usage
            :thickness 4
            :start-at 75
            :clockwise true)
          (label 
            :class "metric-icon"
            :text "󰻠")))
      (button 
        :class "metric-button"
        :onclick "notify-send 'cpu temperature' ' ${cpu_temp}°c${cpu_temp >= 80 ? ' (critical!)' : ''}'"
        :tooltip "temperature:  ${cpu_temp}°c"
        (overlay
          (circular-progress 
            :class "progress-temp ${cpu_temp >= 80 ? 'critical' : ''}"
            :value {cpu_temp >= 80 ? 100 : cpu_temp * 1.25}
            :thickness 4
            :start-at 75
            :clockwise true)
          (label 
            :class "metric-icon"
            :text "")))
      (button 
        :class "metric-button"
        :onclick "notify-send 'disk usage' '󰋊 ${disk_usage}%'"
        :tooltip "disk: 󰋊 ${disk_usage}%"
        (overlay
          (circular-progress 
            :class "progress-disk"
            :value disk_usage
            :thickness 4
            :start-at 75
            :clockwise true)
          (label 
            :class "metric-icon"
            :text "󰋊")))
      (button 
        :class "metric-button"
        :onclick "powerprofilesctl set $(if [ '${current_power_profile}' = 'balanced' ]; then echo 'power-saver'; else echo 'balanced'; fi)"
        :tooltip "power profile: ${current_power_profile}"
        (label 
          :class "power-icon ${current_power_profile}"
          :text {current_power_profile == "power-saver" ? "󰌪" : 
                 current_power_profile == "balanced" ? "󰗑" : ""}))
    )
  )
)


(defwidget volume_scale []
  (overlay :hexpand true
    (scale :min 0 :max 101 :active {volume_muted == "false"} :value {volume_muted == "true" ? 0 : volume} :onchange "pactl set-sink-volume 0 {}%" :class "volume-scale no-slider")
    (label :class 'volume-icon ${volume_muted == "true" ? "less" : volume < 5 ? "less" : "more"}' :halign "start" :text {volume_muted == "true" ? "󰸈" : volume < 40 ? "" : volume < 67 ? "" : ""})
  )
)

(defwidget brightness_scale []
  (overlay :hexpand true
    (scale :min 0 :max max_brightness :active true :value brightness :onchange "brightnessctl set {}" :class "brightness-scale no-slider")
    (label :class 'brightness-icon ${brightness < 10 ? "low" : brightness < 50 ? "medium" : "high"}' :halign "start" :text {brightness < 10 ? "󰃞" : brightness < 50 ? "󰃟" : "󰃠"})
  )
)
