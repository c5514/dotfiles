(include "./music-widget/eww.yuck")
;; calendar popup
(defwidget calendar-popup []
  (box :class "calendar-popup"
    (calendar :class "calendar")))

(defwindow calendar-popup
  :monitor 0
  :geometry (geometry :x "50%"
                      :y "5px"
                      :width "375px"
                      :height "250px"
                      :anchor "top center")
  :stacking "overlay"
  :windowtype "dock"
  (calendar-popup))


;; system information
(defpoll ram_percent 
  :interval "2s" 
  :initial "0"
  `free | grep Mem | awk '{printf "%.0f", ($3/$2) * 100}'`)

(defpoll cpu_usage 
  :interval "1s" 
  :initial "0"
  `grep 'cpu ' /proc/stat | awk '{usage=($2+$4)*100/($2+$4+$5)} END {printf "%.0f", usage}'`)

(defpoll cpu_temp 
  :interval "3s" 
  :initial "0"
  `cat /sys/class/thermal/thermal_zone0/temp | awk '{printf "%.0f", $1/1000}' || echo "0"`)

(defpoll disk_usage 
  :interval "30s" 
  :initial "0"
  `df -h / | awk 'NR==2 {printf "%.0f", $5}' | sed 's/%//g'`)

(defpoll current_power_profile 
  :interval "1s" 
  :initial "balanced"
  `powerprofilesctl get 2>/dev/null || echo "balanced"`)

;; menu
(defwindow menu_popup
  :monitor 0
  :geometry (geometry 
    :x "5px" 
    :y "5px" 
    :width "320px" 
    :height "90px"
    :anchor "top right")
  :stacking "overlay"
  :windowtype "dock"
  :wm-ignore true
  
  (box 
    :orientation "vertical" 
    :class "popup-container"
    :spacing 10
    :space-evenly false
    (box :orientation "v" :class "blue-light-menu"
      (blue_light_filter) 
    )
    ;; powermenu
    (box 
      :orientation "horizontal" 
      :class "powermenu-container"
      :spacing 15
      :space-evenly true
      :halign "center"
      (button :class "metric-button"
              :onclick "loginctl poweroff"
              :tooltip "Shutdown"
        (label :class "metric-icon" :text "⏻"))
      (button :class "metric-button"
              :onclick "swaylock -c 000000"
              :tooltip "Lock"
        (label :class "metric-icon" :text ""))
      (button :class "metric-button"
              :onclick "loginctl suspend"
              :tooltip "Suspend"
        (label :class "metric-icon" :text "󰤄"))
      (button :class "metric-button"
              :onclick "niri msg action quit"
              :tooltip "Log out"
        (label :class "metric-icon" :text "󰍃")) 
      (button :class "metric-button"
              :onclick "loginctl reboot"
              :tooltip "Reboot"
        (label :class "metric-icon" :text "⏼"))
    )
    
    ;; system info
    (box 
      :orientation "horizontal" 
      :class "metrics-container"
      :spacing 15
      :space-evenly true
      :halign "center"
      
      (button 
        :class "metric-button"
        :onclick "notify-send 'memory usage' '󰍛 ${ram_percent}%'"
        :tooltip "memory: 󰍛 ${ram_percent}%"
        (overlay
          (circular-progress 
            :class "progress-metric"
            :value ram_percent
            :thickness 4
            :start-at 75
            :clockwise true)
          (label 
            :class "metric-icon"
            :text "󰍛")))
      (button 
        :class "metric-button"
        :onclick "notify-send 'cpu usage' '󰻠 ${cpu_usage}%'"
        :tooltip "cpu: ${cpu_usage}%"
        (overlay
          (circular-progress 
            :class "progress-metric"
            :value cpu_usage
            :thickness 4
            :start-at 75
            :clockwise true)
          (label 
            :class "metric-icon"
            :text "󰻠")))
      (button 
        :class "metric-button"
        :onclick "notify-send 'cpu temperature' ' ${cpu_temp}°c${cpu_temp >= 80 ? ' (critical!)' : ''}'"
        :tooltip "temperature:  ${cpu_temp}°c"
        (overlay
          (circular-progress 
            :class "progress-metric ${cpu_temp >= 80 ? 'critical' : ''}"
            :value {cpu_temp >= 80 ? 100 : cpu_temp * 1.25}
            :thickness 4
            :start-at 75
            :clockwise true)
          (label 
            :class "metric-icon"
            :text "")))
      (button 
        :class "metric-button"
        :onclick "notify-send 'disk usage' '󰋊 ${disk_usage}%'"
        :tooltip "disk: 󰋊 ${disk_usage}%"
        (overlay
          (circular-progress 
            :class "progress-metric"
            :value disk_usage
            :thickness 4
            :start-at 75
            :clockwise true)
          (label 
            :class "metric-icon"
            :text "󰋊")))
      (button 
        :class "metric-button"
        :onclick "powerprofilesctl set $(if [ '${current_power_profile}' = 'balanced' ]; then echo 'power-saver'; else echo 'balanced'; fi)"
        :tooltip "power profile: ${current_power_profile}"
        (label 
          :class "power-icon ${current_power_profile}"
          :text {current_power_profile == "power-saver" ? "󰌪" : 
                 current_power_profile == "balanced" ? "󰗑" : ""}))
    )
  )
)


;; Variables for OSD visibility
(defvar volume_osd_visible false)
(defvar brightness_osd_visible false)
(defpoll volume :interval "50ms" "~/.config/eww/scripts/osd-control.sh get-volume")
(defpoll volume_muted :interval "50ms" "~/.config/eww/scripts/osd-control.sh get-volume-muted")
(defpoll brightness :interval "50ms" "~/.config/eww/scripts/osd-control.sh get-brightness")
(defpoll max_brightness :interval "1s" "~/.config/eww/scripts/osd-control.sh get-max-brightness")

(defwidget volume_scale []
  (overlay :hexpand true
    (scale :min 0 :max 101 :active {volume_muted == "false"} :value {volume_muted == "true" ? 0 : volume} :onchange "~/.config/eww/scripts/osd-control.sh volume-up" :class "volume-scale no-slider")
    (label :class 'volume-icon ${volume_muted == "true" ? "less" : volume < 5 ? "less" : "more"}' :halign "start" :text {volume_muted == "true" ? "󰝟" : volume == 0 ? "󰝟" : volume < 40 ? "" : volume < 67 ? "" : ""})
  )
)

(defwidget brightness_scale []
  (overlay :hexpand true
    (scale :min 0 :max max_brightness :active true :value brightness :onchange "~/.config/eww/scripts/osd-control.sh brightness-up" :class "brightness-scale no-slider")
    (label :class 'brightness-icon ${brightness < 50 ? "low" : brightness < 170 ? "medium" : "high"}' :halign "start" :text {brightness < 50 ? "󰃞" : brightness < 170 ? "󰃟" : "󰃠"})
  )
)

(defwidget volume_osd []
  (box :class "osd-container"
       :orientation "vertical"
       :space-evenly false
       :spacing 10
         (volume_scale)
  )
)

(defwidget brightness_osd []
  (box :class "osd-container"
       :orientation "vertical"
       :space-evenly false
       :spacing 10
         (brightness_scale)
  )
)

;; OSD Windows
(defwindow volume-osd-window
  :monitor 0
  :geometry (geometry :x "0%"
                      :y "8%"
                      :width "250px"
                      :height "60px"
                      :anchor "bottom center")
  :stacking "overlay"
  :reserve (struts :distance "0px" :side "top")
  :windowtype "dock"
  :wm-ignore false
  (revealer :reveal volume_osd_visible
            :transition "slidedown"
            :duration "200ms"
    (volume_osd)))

(defwindow brightness-osd-window
  :monitor 0
  :geometry (geometry :x "0%"
                      :y "8%"
                      :width "250px"
                      :height "60px"
                      :anchor "bottom center")
  :stacking "overlay"
  :reserve (struts :distance "0px" :side "top")
  :windowtype "dock"
  :wm-ignore false
  (revealer :reveal brightness_osd_visible
            :transition "slidedown"
            :duration "200ms"
    (brightness_osd)))

(defpoll filter_value :interval "0.1s" "cat /tmp/blue_light_temp")
(defwidget blue_light_filter []
  (box :class "filter-control"
    (button :class "filter-btn-red" 
            :onclick "~/.config/eww/scripts/blue-light-filter.sh red-light"
            "󰌶")  ; Red light icon
    (label :text {filter_value + " K"} 
    :class "filter-value"
    :halign "center")
    (button :class "filter-btn-blue"
            :onclick "~/.config/eww/scripts/blue-light-filter.sh blue-light"
            "󰌵")  ; Blue light icon
  )
)
